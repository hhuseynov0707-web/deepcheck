# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Trained model artifacts ---
# Regenerated by `python train_model.py`, and backend/entrypoint.sh trains
# them automatically on first container start if they are missing. Kept out of
# git deliberately: model.pkl is a ~10MB binary that would bloat history
# permanently, it is fully reproducible from train_model.py (fixed seed 42),
# and a pickle is version-fragile -- it must be loaded by the same
# scikit-learn version that wrote it (see requirements.txt).
backend/model*.pkl
backend/lstm_model*.pt

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Pitch materials ---
# Contains funding figures, valuation and team details intended for specific
# investors and applications, not for a public repository.
pitch/

# --- Internal security documents ---
# AUDIT.md is a working document describing unpatched attack paths against the
# live system (client-side enforcement bypass, unauthenticated session
# poisoning, detector evasion). It is useful to keep locally and actively
# harmful to publish -- it is a ready-made attack guide, and the issues it
# describes are not all fixed yet. Keep it out of the repository until they are.
AUDIT.md

# AUDIT_ADVERSARIAL.md and redteam/ are the same category: a measured, working
# evasion recipe against the live detector (2 px of pointer jitter halves the
# risk score), plus the generators that produce it. The weaknesses it describes
# are not fixed, so publishing it would hand an attacker the method before the
# fix exists. Keep locally; publish a sanitised version once the normalisation
# and the unscored provenance signals are addressed.
AUDIT_ADVERSARIAL.md
redteam/

# --- Regenerated agent instruction copy ---
# AGENTS.md is a byte-for-byte copy of CLAUDE.md that tooling recreates on its
# own. Two files with the same content drift the moment one is edited, and
# CLAUDE.md is the one this repository maintains, so the copy stays out of git
# rather than being deleted over and over.
AGENTS.md

# --- Claude Code local settings ---
# Machine-specific permission list containing absolute paths to this user's
# home and temp directories. The non-.local settings.json is the shareable one.
.claude/settings.local.json

# --- Generated documents ---
# Built from the repository's own docs by a Chromium print pass, so it is a
# derived artifact rather than a source: 380 KB of binary that would be
# rewritten wholesale on every regeneration and bloat history permanently.
# Same reasoning as the model pickles above. Regenerate when the docs change.
*.pdf

# --- Editors & OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Recorded behavioral sessions are personal data -- keep the report, not the recordings.
data/real/**/*.json
