# Copy to .env and fill in before any non-local deployment:
#   cp .env.example .env
#
# docker-compose reads this file automatically. With DEBUG=1 (the default for
# the local demo) the backend falls back to fixed development values and warns
# about it on every boot. With DEBUG=0 it REFUSES TO START unless both secrets
# below are set -- a missing secret must never quietly turn authentication off.

# Signs session tokens (HMAC-SHA256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEEPCHECK_SECRET=

# Guards the SOC dashboard endpoints (GET /api/sessions, GET /api/score/{id}).
# The analyst types this into the dashboard's key prompt. It is deliberately
# NOT built into the frontend bundle: anything compiled into the bundle is
# served to every visitor, which would make the header check decoration.
DASHBOARD_KEY=

# 1 = local demo (development fallbacks allowed). 0 = production.
DEBUG=1

# Comma-separated browser origin allowlist for CORS. "*" is the default and is
# fine for a laptop demo only.
# CORS_ORIGINS=https://demo.example.com,https://soc.example.com

# Step-up verification code accepted by POST /api/demo/verify and shown in the
# demo's verification modal. A stand-in for a real SMS / 3-D Secure provider.
DEMO_VERIFY_CODE=482913

# Backend URL compiled into the frontend bundle at BUILD time. Change it and
# rebuild the frontend image; it is not read at container start.
# VITE_API_URL=http://localhost:8000

# Data retention. Raw telemetry (the recorded mouse path, click and key
# timestamps) is blanked after RAW_RETENTION_HOURS, leaving the six features
# and the score; whole rows go after ROW_RETENTION_HOURS. Recordings of real
# people should not accumulate indefinitely, and nothing after scoring needs
# them except record_session.py, which runs promptly.
# RAW_RETENTION_HOURS=1
# ROW_RETENTION_HOURS=24
