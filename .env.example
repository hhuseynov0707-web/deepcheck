# Copy to .env and fill in before any non-local deployment:
#   cp .env.example .env
#
# docker-compose reads this file automatically. With DEBUG=1 (the default for
# the local demo) the backend falls back to fixed development values and warns
# about it on every boot. With DEBUG=0 it REFUSES TO START unless both secrets
# below are set -- a missing secret must never quietly turn authentication off.
#
# What runs where (docker-compose.yml, docs/architecture-two-apps.md):
#   http://localhost:3000  the store: TechStore's checkout (checkout-web + checkout-api)
#   http://localhost:3100  the SOC (soc-web + soc-api), login with DASHBOARD_KEY
#   http://localhost:8000  the core API itself
# Every port is bound to 127.0.0.1 by default. The legacy combined demo that
# used to sit on 3200 (frontend/, docker-compose.dev.yml) was deleted on
# 2026-10-02; nothing listens there any more.
#
# The core needs nothing here for the default `docker-compose up --build`: the
# development values are in force. The store and the SOC do: their two servers have NO development fallback in any mode,
# DEBUG=1 included, and refuse to start until the block "The store and the
# SOC" below is filled in. The LAN section at the bottom is the one to read
# before a live demo.

# Signs session tokens (HMAC-SHA256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEEPCHECK_SECRET=

# Guards the core's SOC endpoints (GET /api/sessions, GET /api/score/{id}).
# The analyst types it into the SOC login at http://localhost:3100, where
# soc-api compares it and hands the browser a signed cookie instead (the key
# is never stored in the browser). It is deliberately NOT built into any
# bundle: anything compiled into a bundle is served to every visitor, which
# would make the header check decoration.
#
# With DEBUG=1 and this left empty the core uses its published development
# key, but soc-api cannot see that fallback and has none of its own: SET it
# here whenever the SOC is to work, DEBUG=1 included.
DASHBOARD_KEY=

# 1 = local demo (development fallbacks allowed). 0 = production.
DEBUG=1

# -----------------------------------------------------------------------------
# The store and the SOC (apps/; contract: docs/architecture-two-apps.md)
# -----------------------------------------------------------------------------
# Minimal local setup, DEBUG=1 on 127.0.0.1 -- four DIFFERENT tokens, each from
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
#   DASHBOARD_KEY=<token 1>                       (above)
#   SOC_SESSION_SECRET=<token 2>
#   DEEPCHECK_MERCHANT_KEYS=techstore:<token 3>   (profile block below)
#   CHECKOUT_MERCHANT_ID=techstore
#   CHECKOUT_MERCHANT_KEY=<token 3 again>
#   CHECKOUT_CUSTOMER_REF_KEY=<token 4>
#
# then `docker compose up -d --build`. Unset, checkout-api and soc-api exit at
# boot with a sentence naming the missing variable (`docker compose logs
# checkout-api soc-api`); the store page then answers 502 under /api/ and
# never takes a payment, and the SOC login cannot succeed.
#
# For the SOC's "Son kaydedilen karar" line to show the store's decisions, the
# profile layer must also be on (PROFILE_LAYER=1 and DEEPCHECK_PROFILE_KEY,
# profile block below): decision_audit is written only while it is. The store
# creates no profile for anyone -- it never calls the consent endpoint -- so
# its customers are "no_profile" and the layer only records the decision.

# The store's merchant credential. checkout-api sends it as X-Merchant-Id /
# X-Merchant-Key with every POST /api/decision. It is NOT what the customer
# reference is derived from (CHECKOUT_CUSTOMER_REF_KEY below): the core holds
# this key too.
#
# The pair MUST equal one "id:key" entry of DEEPCHECK_MERCHANT_KEYS, whose
# rules apply (profile block below: id of lowercase letters, digits, "_" or
# "-", at most 32 characters, never "demo"; key at least 32 printable
# characters with no spaces and no commas, different from every other secret
# here). That entry is needed whether or not the profile layer is on: the core
# authenticates every request that names a customer. A mismatch is NOT a boot
# error: the core answers 401, the store fails closed, and every payment ends
# in "Ödeme şu anda işlenemiyor" (HTTP 503) -- none is ever paid.
CHECKOUT_MERCHANT_ID=
CHECKOUT_MERCHANT_KEY=

# The key the store derives its customer reference from. The store is a guest
# checkout: the page asks for no e-mail address, account or other identifier,
# so the reference names one checkout SESSION, not a person:
# "misafir-" + HMAC-SHA256(this key, "session:" + session_id)[:24]
# (customer_ref_for in apps/checkout-server/main.py). It is sent at all only
# because the core writes a plain "allow" to decision_audit just when a
# customer is named (main._learn_and_audit), and the SOC's "Son kaydedilen
# karar" reads that row. One reference per session also means every checkout
# has its own per-customer decision bucket, so rehearsals cannot use up the
# stage payment's. Held by checkout-api ONLY -- never put it in
# DEEPCHECK_MERCHANT_KEYS or anywhere the core reads: without it nobody else
# can compute a reference from a session id. Not the merchant key, because the
# core holds that one and receives it with every decision. Generate it
# separately:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# At least 32 characters and never equal to CHECKOUT_MERCHANT_KEY, or
# checkout-api refuses to start; no fallback in any mode.
CHECKOUT_CUSTOMER_REF_KEY=

# Signs the SOC login cookie (HMAC-SHA256; the cookie expires after 8 hours).
# At least 32 characters and different from DASHBOARD_KEY, or soc-api refuses
# to start. No fallback in any mode: a random per-process secret would log the
# analyst out on every restart, and a fixed one would be public in this
# repository. Changing it logs every analyst out at once.
SOC_SESSION_SECRET=

# 1 adds the Secure attribute to the SOC cookie. Leave it unset for the
# loopback demo at http://localhost:3100; set it as soon as the SOC is served
# over https.
# SOC_COOKIE_SECURE=0

# Comma-separated browser origin allowlist for CORS. "*" is the default and is
# fine for a laptop demo only. None of the bundled pages needs it: the store's
# SDK calls the core on the store's own origin (/deepcheck/api/, through
# checkout-web's nginx), and the SOC never calls the core from the browser at
# all (soc-api does, server to server). A same-origin request is never subject
# to CORS. It matters only for a page on ANOTHER origin calling the core -- a
# merchant's own site embedding the SDK, or the lab harness (lab/bot_lab.py,
# lab/capture.py), which an allowlist without its origin shuts out.
#
# The lab harness's default origin is http://127.0.0.1:3300 (3000 and 3100 are
# the store and the SOC); put that origin in this list if the list is set.
# CORS_ORIGINS=https://demo.example.com,https://soc.example.com

# Step-up verification code accepted by POST /api/demo/verify and shown in the
# store's code dialog (checkout-web compiles it in at build time: change it,
# then rebuild that image). A stand-in for a real SMS / 3-D Secure provider.
DEMO_VERIFY_CODE=482913

# VITE_API_URL is no longer read by anything: it was compiled into the legacy
# demo's bundle (frontend/), deleted on 2026-10-02. The store and the SOC have
# no such setting; both always call their own origin. An old .env that still
# sets it changes nothing.

# Host address the STORE's port 3000 (checkout-web) is published on, and the
# only thing this variable opens. Through that one port nginx serves the
# store's page, the store's server under /api/, and the core under
# /deepcheck/api/ (the SDK's session, attest and analyze calls). 127.0.0.1
# (the default) keeps all of it off the network; 0.0.0.0 is the LAN demo
# below. Do not set 0.0.0.0 while DEBUG=1: the core's token secret is then the
# published development value, so anyone on the network could forge session
# tokens. The SOC (3100) is published on 127.0.0.1 whatever this says
# (docker-compose.yml explains why).
# BIND_ADDR=127.0.0.1
#
# Host address the backend's own port 8000 is published on. Independent of
# BIND_ADDR and loopback by default, because browsers do not need it. Open it
# only for the lab harness pointed at the backend directly from another machine
# (lab/bot_lab.py --api http://<IP>:8000). On the same machine the lab tools
# and live_bot.py --legacy reach the core at http://127.0.0.1:8000 with this
# left alone. Port 3000 does NOT reach the whole core: its /api/ is the
# store's own server, and only the SDK's calls sit under /deepcheck/api/
# there. Same DEBUG=0 rule. Postgres stays on 127.0.0.1 regardless of both.
# API_BIND_ADDR=127.0.0.1

# Which peers uvicorn trusts to name the real client in X-Forwarded-For (read
# by uvicorn itself; main.py never reads the header). Browsers reach the core
# through the store's nginx (checkout-web, /deepcheck/api/), so without this
# the backend sees that container's address on every request, and the per-IP
# session-minting limit (10 per minute per worker) is ONE bucket shared by
# every visitor of the store. Set it to that container's address to key the
# limit per visitor again. The nginx overwrites X-Forwarded-For with the
# address it saw, so a client cannot pick its own key. Find the address with
#   docker inspect -f "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}" deepcheck-checkout-web
# and apply it with `docker compose up -d`. Recreating the container can give
# it a new address; a stale value fails safe (back to the shared bucket).
# Exact addresses only: the pinned uvicorn 0.30.1 has no CIDR support. NEVER
# "*" here: uvicorn then believes the leftmost X-Forwarded-For entry, which the
# caller writes, and this port CAN be published (API_BIND_ADDR). checkout-api
# sets "*" in its own image only because it publishes no port at all. Unset is
# safe, only coarser.
#
# Under Docker Desktop (the jury laptop) this does NOT give per-visitor keys,
# because nginx never sees the visitor either: Docker Desktop's port forwarder
# hands it the compose network's gateway as the peer. Measured from the host:
# with a connection held open, /proc/net/tcp in deepcheck-checkout-web showed
# 172.20.0.1, the gateway of 172.20.0.0/16. So nginx forwards that one address
# for everyone, and every per-address limit behind it -- this one and the
# store's own (checkout-api: 10 checkouts and 10 code attempts a minute) -- is
# per HOST, not per visitor. A bot looping from laptop A and a person paying
# from laptop B draw from the same buckets. LAN connections were not measured
# from a second machine; the forwarder is expected to present them the same
# way.
# FORWARDED_ALLOW_IPS=<checkout-web address>

# Postgres credentials. docker-compose builds the backend's DATABASE_URL from
# the same three values, so they only need setting here. The password goes
# into a URL: use letters, digits, "-" and "_" only (token_urlsafe output
# qualifies).
#
# Postgres applies these only when it creates an EMPTY data volume. Changing
# POSTGRES_PASSWORD on a machine that has already run the stack does not
# change the database's password; the backend then fails to authenticate.
# Either set it before the first `up`, or recreate the volume -- which DELETES
# every stored session:
#   docker-compose down -v && docker-compose up --build
# Host-side tools such as record_session.py connect through
# 127.0.0.1:5432 and need the same credentials, e.g.
#   DATABASE_URL=postgresql+asyncpg://deepcheck:<password>@localhost:5432/deepcheck
# POSTGRES_USER=deepcheck
# POSTGRES_PASSWORD=deepcheck
# POSTGRES_DB=deepcheck

# Data retention. Raw telemetry (the recorded mouse path, click and key
# timestamps) is blanked after RAW_RETENTION_HOURS, leaving the twelve features
# and the score; whole rows go after ROW_RETENTION_HOURS. Recordings of real
# people should not accumulate indefinitely, and nothing after scoring needs
# them except record_session.py, which runs promptly.
#
# These two are also the storage knob. Measured on Postgres 16: a flush row
# carrying a typical 10 s mouse window costs about 6.1 kB on disk, and 644 B
# once blanked -- so the first hour is roughly 183 kB per 60-second checkout
# and the remaining 23 hours about 19 kB. Lowering RAW_RETENTION_HOURS is the
# cheapest way to cut storage; the arithmetic is TECHNICAL_GUIDE.md section 17.4.
# RAW_RETENTION_HOURS=1
# ROW_RETENTION_HOURS=24
#
# Per-customer profile retention, swept separately from the telemetry above
# (its own transaction and lock, so a failure in one never stops the other).
# An idle profile and its stored session vectors go after
# PROFILE_RETENTION_DAYS without a decision; an objection record is never
# swept, because it is what stops a refused profile from being recreated.
# Decision audit rows (the evidence for a human review of a contested
# decision) and profile access audit rows have their own clocks. Policy
# defaults to be confirmed in the DPIA, not measurements.
# PROFILE_RETENTION_DAYS=180
# DECISION_AUDIT_RETENTION_DAYS=90
# PROFILE_ACCESS_RETENTION_DAYS=365

# /api/demo/charge and /api/demo/verify. Defaults to DEBUG. Their step-up code
# is a fixed constant the store's code dialog prints on screen, so any session
# the server answers "verify" for can be upgraded to "allow" by anyone who
# reads it. That is the point in a demo and unacceptable in a deployment. The
# store uses /api/demo/verify (through checkout-api); /api/demo/charge is used
# only by demo_seed.py --simulate and the lab tools, against the core itself.
# DEMO_ENDPOINTS=0

# Return the SHAP breakdown to the client being scored. Off by default: naming
# the features that convicted a caller lets it tune against the live detector.
# The dashboard still gets the full explanation from GET /api/score/{id}.
# SHAP_IN_ANALYZE=0

# Escalate sessions that share a behavioural signature with many others.
# Off by default on the evidence: against the adversarial harness it challenged
# 8-40% of legitimate sessions to catch 4-60% of mimics, depending on the
# threshold, and a control that flags more customers than attackers is worse
# than no control. The signature is still computed and stored, because it is
# where identity signals (device, TLS, IP) would attach -- those cluster far
# more reliably than behaviour does.
# CLUSTER_ESCALATION=0

# -----------------------------------------------------------------------------
# Per-customer behavioural profile (OFF unless every variable below is set)
# -----------------------------------------------------------------------------
# A customer's own behavioural history may ask for EXTRA VERIFICATION and
# nothing else: it never blocks, never approves and never changes a risk score.
# It is the only control aimed at human account takeover and does nothing
# against card-testing bots. It has NOT been measured on real customers, so it
# ships off. The local demo needs none of this: with these unset, every
# endpoint behaves exactly as it does without the layer.
#
# There is no development fallback for ANY of these, DEBUG=1 included. The
# layer is on only when PROFILE_LAYER=1 AND DEEPCHECK_PROFILE_KEY is set AND at
# least one merchant is configured.
#
# Merchant credentials, "id:key" pairs, comma separated. A merchant backend
# sends X-Merchant-Id / X-Merchant-Key with every customer_ref and with the
# consent, erase and outcome calls. id: lowercase letters, digits, "_" or "-",
# at most 32 characters, starting with a letter or digit; "demo" is reserved.
# key: at least 32 printable ASCII characters, no spaces, different for every
# merchant and different from every other secret here. A malformed entry
# stops the backend from starting, in every mode.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The store (CHECKOUT_MERCHANT_ID / CHECKOUT_MERCHANT_KEY above) needs its own
# entry here whether or not the layer is on: the core authenticates every
# request that names a customer, and the store names one on every payment.
# DEEPCHECK_MERCHANT_KEYS=acme:<token>,globex:<another token>
#
# The HMAC key that turns (merchant, customer reference) into the stored
# profile id; the raw reference is never stored. Must differ from
# DEEPCHECK_SECRET, DASHBOARD_KEY and every merchant key (checked at boot).
#
# ROTATING IT IS A SILENT MASS RESET. A pseudonym cannot be re-keyed without
# the raw references, which this system deliberately never keeps, so a new
# key re-derives every profile id: every customer becomes a stranger at once,
# the old profiles are orphaned until the idle-retention sweep removes them,
# no erasure or objection request can match them any more, and an objection
# recorded under the old key no longer refuses a consent under the new one
# (objection records are never swept, but they can no longer be found). Treat the key
# as long-lived, and its compromise as re-identifying the whole profile table.
# DEEPCHECK_PROFILE_KEY_VERSION is written on every profile, and a profile
# stamped with a different version is never compared: it exists so a future
# rotation can dual-write for a window instead. Bump it only together with a
# key change.
# DEEPCHECK_PROFILE_KEY=
# DEEPCHECK_PROFILE_KEY_VERSION=1
#
# PROFILE_LAYER=1 computes, stores and audits the layer's opinion (shadow
# mode). PROFILE_ESCALATION=1 additionally lets it ask for verification, and
# is ignored while PROFILE_LAYER is off. Do not turn escalation on before the
# layer has been measured on a real person across sessions and devices.
# PROFILE_LAYER=0
# PROFILE_ESCALATION=0
#
# Per-operator credentials for GET /api/profile/review/{session_id}, the human
# review of a contested decision (GDPR Art. 22(3), KVKK 11(1)(g)): the
# customer's stored session vectors and what the layer said about them.
# Same "id:key" format and rules as DEEPCHECK_MERCHANT_KEYS, one entry per
# PERSON, and every key different from every merchant key, the profile key
# and the dashboard key (checked at boot). Deliberately not DASHBOARD_KEY: that
# is one shared password, and every review is written to profile_access_audit
# under the operator id, which a shared key cannot attribute to anyone. Unset
# means nobody can review. Not tied to PROFILE_LAYER, so a decision made while
# the layer was on stays reviewable after it is switched off.
# PROFILE_REVIEW_KEYS=denetci-ayse:<token>

# Leading zero bits required of the session proof of work. 12 costs Chromium
# about 75 ms and a native script about 2 ms -- the asymmetry runs the wrong
# way, because JavaScript SHA-256 is roughly thirty times slower than native,
# so raising this taxes real customers harder than it taxes attackers. Treat it
# as evidence that code executed, not as a cost barrier.
# POW_DIFFICULTY_BITS=12

# Uvicorn worker processes (entrypoint.sh). Each holds its own model in memory.
# UVICORN_WORKERS=2

# -----------------------------------------------------------------------------
# LAN demo: a second laptop opens the store over Wi-Fi
# -----------------------------------------------------------------------------
# The step-by-step runbook, in Turkish, is docs/canli-demo.md; this is the
# variable-level summary. The jury setup: laptop A runs the stack and shows
# the SOC at http://localhost:3100 on the projector (laptop A only). Laptop B,
# on the same Wi-Fi or hotspot, opens the store at http://<A-IP>:3000, pays by
# hand, then runs the scripted bot against the same store (live_bot.py copied
# to B's Desktop: python live_bot.py --url http://<A-IP>:3000).
#
# Port 3000 is the only one B needs and the only one BIND_ADDR opens. Through
# it nginx serves the store's page, the store's server under /api/, and an
# ALLOW LIST of the core under /deepcheck/api/ (session, session/attest,
# analyze, health -- what the SDK and live_bot.py use). The core's decision,
# demo-verify, SOC and profile endpoints are not reachable through it: the
# store's decisions go through the store's server. A's address is compiled
# into nothing.
#
#  1. Put these in laptop A's .env (real values, not the placeholders; every
#     token different, each from
#     python -c "import secrets; print(secrets.token_urlsafe(32))"):
#       DEBUG=0
#       DEEPCHECK_SECRET=<token 1>
#       DASHBOARD_KEY=<token 2>
#       DEMO_ENDPOINTS=1          # DEBUG=0 turns the demo code step off otherwise
#       BIND_ADDR=0.0.0.0         # port 3000 only; 3100 and 8000 stay on loopback
#       PROFILE_LAYER=1
#       DEEPCHECK_PROFILE_KEY=<token 3>
#       DEEPCHECK_MERCHANT_KEYS=demo-magaza:<token 4>
#       CHECKOUT_MERCHANT_ID=demo-magaza
#       CHECKOUT_MERCHANT_KEY=<token 4 again>
#       CHECKOUT_CUSTOMER_REF_KEY=<token 5: generated separately, >= 32
#                                  characters, never equal to the merchant key>
#       SOC_SESSION_SECRET=<token 6>
#     DEBUG=0 is not optional. With DEBUG=1 the token secret is the published
#     development value, and BIND_ADDR=0.0.0.0 puts the API that accepts it in
#     reach of everyone on the network.
#     Without the three CHECKOUT_ lines checkout-api refuses to start, and
#     without SOC_SESSION_SECRET soc-api does: the store then answers 502
#     under /api/ and the SOC login cannot succeed.
#     The profile lines are what the SOC's "Son kaydedilen karar" reads: that
#     is decision_audit, written only while the profile layer is on
#     (main._learn_and_audit). The store creates no profile for anyone, so its
#     customers are "no_profile" and the layer only records the decision.
#     PROFILE_ESCALATION may be 0 or 1. Every decision naming a customer
#     spends that customer's per-customer bucket (RATE_LIMITS["profile"], 60
#     per hour per worker) -- the store's hidden re-asks included -- and with 1
#     an empty bucket turns an approval into the code step. The store names a
#     fresh guest reference for every checkout session (CHECKOUT_CUSTOMER_REF_KEY
#     above), so each checkout has a bucket of its own and rehearsals cannot use
#     up the stage payment's. No new address or identity is needed per run.
#     Leave CORS_ORIGINS and API_BIND_ADDR unset.
#
#  2. Build and start, once:
#       docker compose up -d --build
#     A new IP later needs no rebuild, and changing BIND_ADDR needs only
#     `docker compose up -d`. If it fails with "ports are not available",
#     Windows has reserved 3000 for Hyper-V since the last reboot; this lists
#     the reserved ranges:
#       netsh interface ipv4 show excludedportrange protocol=tcp
#
#  3. Find laptop A's address with `ipconfig`: the Wi-Fi adapter's IPv4
#     Address, not a "vEthernet (WSL)" or Default Switch 172.x entry.
#     192.168.1.20 below. Use the number: a host name may resolve to IPv6, and
#     the 0.0.0.0 publish is IPv4 only.
#
#  4. Inbound TCP 3000, and only 3000, must get through laptop A's Windows
#     Firewall. Check the network profile first (PowerShell):
#       Get-NetConnectionProfile
#     Venue Wi-Fi usually comes up as Public. Windows drops inbound
#     connections no rule allows, and Docker Desktop is often allowed on
#     Private networks only. Either switch that network to Private (Settings >
#     Network & internet > Wi-Fi > <network> > Network profile type), or add a
#     rule scoped to the local subnet. The presenter runs this themselves, in
#     an ADMINISTRATOR PowerShell:
#       New-NetFirewallRule -DisplayName "DeepCheck demo 3000" -Direction Inbound -Protocol TCP -LocalPort 3000 -Action Allow -Profile Private,Public -RemoteAddress LocalSubnet
#     and removes it after the demo:
#       Remove-NetFirewallRule -DisplayName "DeepCheck demo 3000"
#     A Block rule on Docker Desktop's backend process beats any port Allow
#     rule; look for one if the port stays closed. If the stack has only ever
#     run on 127.0.0.1, the first 0.0.0.0 publish may raise a firewall prompt:
#     rehearse on a network like the venue's, not at home.
#
#  5. Health checks. On laptop A:
#       http://localhost:3000/api/health            -> "core": true
#                                                      (the store's server reaches the core)
#       http://localhost:3000/deepcheck/api/health  -> "model_loaded": true
#                                                      (the core, through the store's nginx)
#       http://localhost:3100                       -> the SOC login
#     From laptop B, before the jury:
#       Test-NetConnection 192.168.1.20 -Port 3000
#     (not ping: Windows drops ICMP echo by default), then open
#     http://192.168.1.20:3000/api/health and expect "core": true -- one
#     request that proves the firewall, nginx, the store's server and the
#     core. The store is then http://192.168.1.20:3000.
#
# Venue Wi-Fi often isolates clients from each other, and then B cannot reach
# A whatever the firewall says. The fallback is a phone hotspot both laptops
# join: A gets a new address, B types the new URL, nothing is rebuilt.
#
# A tunnel (cloudflared, ngrok) is NOT recommended as a way around any of
# this. It routes every page and every behavioural payload through a third
# party's servers, possibly abroad, while docs/kvkk-aydinlatma.md tells the
# person being recorded that the data is sent to no third party. The demo
# would make that statement untrue while showing it.
#
# What still holds and what does not, over plain http on a LAN:
#  - The SDK works. Its session proof of work hashes with crypto.subtle, which
#    browsers only expose on https or localhost; on http://<LAN-IP> it falls
#    back to a bundled JavaScript SHA-256 instead of failing to register.
#  - Nothing is encrypted in transit. The card's display fields, the
#    verification code and the session token cross the Wi-Fi in clear text, and
#    the browser on B shows "Güvenli değil" (Not secure) in the address bar --
#    expected for this demo; a real payment page is https. Open the SOC on
#    laptop A only (it is published on loopback), where its login stays on
#    the machine. Use keys generated for the demo and replace them afterwards.
#  - The store's page receives no score. The core answers the SDK's analyze
#    calls on port 3000 with {session_id, accepted} only (checkout-web sets
#    X-DeepCheck-Reply: ack), so neither the page nor DevTools on B shows one.
#    Only a caller of the core's own port 8000 gets the full reply (the lab
#    tools, on laptop A; that port is loopback unless API_BIND_ADDR opens it).
#  - The demo verification code is printed in the store's code dialog, so
#    anyone on the network can pass step-up. That is what DEMO_ENDPOINTS=1 means.
#  - Every per-address limit is per HOST under Docker Desktop (see
#    FORWARDED_ALLOW_IPS above): the core's session minting (10 page loads
#    per minute per backend worker) and the store's 10 checkouts and 10 code
#    attempts a minute are shared by laptop A, laptop B and the bot. Do not
#    loop the bot just before the hand payment, and leave about a minute of
#    quiet after a burst of rehearsals; the counters live in memory, so
#    `docker compose restart backend checkout-api` also clears them.
#
# Afterwards, remove BIND_ADDR (or set it to 127.0.0.1) and run
# `docker compose up -d`. No rebuild is needed.

# -----------------------------------------------------------------------------
# Jury prototype: SYNTHETIC demo customers (backend/demo_seed.py)
# -----------------------------------------------------------------------------
# The team has no customer base, so the profile layer is shown on synthetic
# customers: simulator identities (Ayse, Mehmet, Zeynep) seeded with 20 mouse
# and 20 keyboard sessions each, in the reserved "demo" merchant namespace. No
# person is behind them, and everything written says so: is_synthetic on the
# profile, its vectors and every decision about it, "sentetik" in the customer
# references, "Sentetik demo verisi" on the SOC panel, and the simulated-session
# banner in demo_seed.py's own output. No measurement reads them
# (backend/test_demo.py fails if one starts to).
#
# There is no page for them any more. The legacy demo page, the only place a
# person could pay AS one of them, was deleted on 2026-10-02, and the store
# never names them (its server sends a fresh guest reference per session in its
# own merchant namespace). What runs is the CLI contrast case: --simulate
# draws a NEW session from the SAME synthetic identity, sends it through the
# core's real HTTP path (/api/session, attestation, /api/analyze, then
# /api/demo/charge in the "demo" namespace), prints the decision, and the SOC
# shows that session labelled synthetic. It is expected not to be challenged.
# The opposite act -- a real person deviating from a synthetic history and
# being asked for the code -- has no path in the current stack. Either way it
# shows the MECHANISM, not accuracy on real people.
#
# Everything below is for the demo machine only. Put it in .env, then:
#   docker compose up -d --build
#   docker compose exec backend python demo_seed.py            # seed (idempotent)
#   docker compose exec backend python demo_seed.py --status   # what is stored
#   docker compose exec backend python demo_seed.py --reset    # start over
#   docker compose exec backend python demo_seed.py --simulate ayse
#
#   DEEPCHECK_PROFILE_KEY=<python -c "import secrets; print(secrets.token_urlsafe(32))">
#   DEEPCHECK_MERCHANT_KEYS=ornek-satici:<a second, different token>
#   PROFILE_LAYER=1
#   PROFILE_ESCALATION=1
#   DEMO_ENDPOINTS=1
#
# - The merchant entry is never used by the synthetic customers (demo_seed.py
#   files them under the reserved "demo" id, which no merchant may take), but
#   the layer does not switch on without at least one merchant. On the two-
#   laptop demo the store's entry (demo-magaza:...) already satisfies this.
# - PROFILE_ESCALATION=1 is for this demo only; it is what lets a deviation
#   turn into a step-up. With 0 the comparison still runs and is recorded in
#   shadow mode, and nobody is asked for anything.
# - DEMO_ENDPOINTS=1 is needed whenever DEBUG=0.
# - Each synthetic customer can challenge at most 3 times in 30 days
#   (profiles.PROFILE_MAX_ESCALATIONS), rehearsals included; --reset restores
#   the budget. The seed refuses to touch a customer whose stored state is not
#   what it wrote, and says so; --reset is the answer there too.
# - Rotating DEEPCHECK_PROFILE_KEY orphans the seeded customers; run the seed
#   again afterwards.
# - --simulate talks to the API inside the backend container at
#   http://localhost:8000. Override with DEMO_SEED_API_URL or --api-url only when
#   running demo_seed.py outside the container.

# -----------------------------------------------------------------------------
# Paths the training and evaluation code reads. None of these belongs in a
# deployment .env: every one defaults to the right thing, and they exist so a
# measurement run can point somewhere else without disturbing what is serving.
# They are listed here because this file claims to document every variable the
# code reads, and these three were not.
# -----------------------------------------------------------------------------

# Where the trained bundle is written and read from.
# Default: backend/ (what the container and every existing caller assume).
#
# Set it to train into a scratch directory instead of over the served model:
#
#   DEEPCHECK_MODEL_DIR=/tmp/candidate python train_model.py
#
# Retraining in place swaps the model out from under a running container
# mid-request, and out from under anyone else running the test suite. The
# artifact name carries the scikit-learn version, so host and container each
# keep their own (backend/ is bind-mounted and the two pin different versions).
# DEEPCHECK_MODEL_DIR=

# The browser-lab telemetry file train_model.py blends into training.
# Default: lab/real_telemetry.json, beside backend/ on the host and at /lab in
# the container (docker-compose mounts it; without that mount the container
# silently trains on synthetic data alone).
# REAL_TELEMETRY_PATH=

# The recorded-session archive, read in place as a second source of real rows.
# Default: data/real/, likewise beside backend/ on the host and at /data/real
# in the container. Recordings are gitignored on purpose and are NOT copied
# into the tracked lab file: that would walk a real person's raw pointer and
# keystroke timings into git history.
# RECORDED_SESSIONS_DIR=
