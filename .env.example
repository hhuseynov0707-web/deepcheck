# Copy to .env and fill in before any non-local deployment:
#   cp .env.example .env
#
# docker-compose reads this file automatically. With DEBUG=1 (the default for
# the local demo) the backend falls back to fixed development values and warns
# about it on every boot. With DEBUG=0 it REFUSES TO START unless both secrets
# below are set -- a missing secret must never quietly turn authentication off.

# Signs session tokens (HMAC-SHA256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEEPCHECK_SECRET=

# Guards the SOC dashboard endpoints (GET /api/sessions, GET /api/score/{id}).
# The frontend sends the same value as VITE_DASHBOARD_KEY.
DASHBOARD_KEY=

# 1 = local demo (development fallbacks allowed). 0 = production.
DEBUG=1

# Comma-separated browser origin allowlist for CORS. "*" is the default and is
# fine for a laptop demo only.
# CORS_ORIGINS=https://demo.example.com,https://soc.example.com

# Step-up verification code accepted by POST /api/demo/verify and shown in the
# demo's verification modal. A stand-in for a real SMS / 3-D Secure provider.
DEMO_VERIFY_CODE=482913
